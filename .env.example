AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# 生产库是 PostgreSQL（Neon）。运行 python -m daily_news setup-postgres 会自动写入这行，
# 也可以直接把 Neon 连接串粘在这里。留空时命令会提示你先配置，不会退回 SQLite。
# 本地只想用 SQLite 时，用 --database-url sqlite:///news.db 显式指定。
DATABASE_URL=
TIMEZONE=Asia/Shanghai
MORNING_TIME=09:30
EVENING_TIME=21:30

QQ_APP_ID=
QQ_APP_SECRET=
QQ_TARGET_TYPE=c2c
QQ_MESSAGE_MAX_CHARS=1800
QQ_PREVIEW_HOURS=168

AI_TIMEOUT_SECONDS=60
AI_MIN_CALL_INTERVAL_SECONDS=6
AI_MAX_ASSESSMENTS_PER_RUN=12
AI_MAX_CLUSTER_REVIEWS_PER_RUN=12
EMBEDDING_DIMENSIONS=512

REUTERS_ENABLED=true
BLOOMBERG_ENABLED=true
WHITE_HOUSE_ENABLED=true
TRUMP_X_ENABLED=false
X_BEARER_TOKEN=
